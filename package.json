{
  "name": "@josueavalosjim/panelware",
  "version": "0.1.1",
  "description": "An accessible component kit with a chrome-and-LCD skin. Radix UI does the interaction; this does the surface. Stacked inset bevels, Web 2.0 gloss, and a sprite-sheet segment readout. Skins are data-attribute swaps, not separate installs. No runtime dependencies.",
  "keywords": [
    "accessibility",
    "components",
    "css",
    "design-system",
    "design-tokens",
    "radix-ui",
    "react",
    "skeuomorphic",
    "theme"
  ],
  "homepage": "https://github.com/josueavalosjim/panelware#readme",
  "bugs": {
    "url": "https://github.com/josueavalosjim/panelware/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josueavalosjim/panelware.git"
  },
  "license": "MIT",
  "author": "Josue Avalos Jimenez",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./css/panelware.css",
    "./css/tokens": "./css/tokens.css",
    "./css/theme-auto": "./css/tokens/theme-auto.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "css",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/build-sprites.mjs && node scripts/build-icons-index.mjs && node scripts/build-icon-gallery.mjs && node scripts/build-css.mjs && node scripts/build-docs-data.mjs",
    "build": "npm run generate && tsc",
    "test": "tsc && node --test \"test/**/*.test.mjs\"",
    "check": "taste-check",
    "check:runtime": "node scripts/runtime.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:colour": "node scripts/check-colour.mjs",
    "check:cssom": "node scripts/check-cssom.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:pages": "npm run check:overflow && npm run check:parity && npm run check:colour && npm run check:cssom",
    "prepublishOnly": "npm run build",
    "release": "npm test && npm run check && npm run check:runtime && npm run check:pages && npm version minor -m \"Release %s\" && git push --follow-tags",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "radix-ui": "^1.6",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "radix-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@josueavalosjim/taste-check": "^0.12.0",
    "@types/react": "^19.2.18",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3"
  }
}
